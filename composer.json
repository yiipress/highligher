{
    "name": "yiipress/highlighter",
    "type": "php-ext",
    "description": "Native PHP extension for fast server-side syntax highlighting with syntect",
    "license": "BSD-3-Clause",
    "require": {
        "php": ">=8.1"
    },
    "keywords": [
        "php-extension",
        "pie",
        "rust",
        "syntect",
        "syntax-highlighting",
        "yiipress"
    ],
    "support": {
        "issues": "https://github.com/yiipress/highligher/issues",
        "source": "https://github.com/yiipress/highligher"
    },
    "php-ext": {
        "extension-name": "highlighter",
        "download-url-method": [
            "pre-packaged-binary",
            "composer-default"
        ]
    }
}
